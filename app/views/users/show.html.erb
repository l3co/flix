<section class="user">
  <h1><%= @user.name %></h1>
  <h2><%= mail_to(@user.email) %></h2>
  <p>Member since <%= time_ago_in_words(@user.created_at) %> ago</p>
  <% if current_user?(@user) %>
    <div class="actions">
      <%= link_to "Edit", edit_user_path(@user), class: "button edit" %>
      <%= link_to "Delete", @user, method: :delete, data: { confirm: "Are you sure?" }, class: "button delete" %>
    </div>
  <% end %>
  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <section class="review">
        <h2><%= link_to review.movie.title, review.movie %></h2>
        <h3><%= review.user.name %></h3>
        <p><%= review.comment %></p>
      </section>
    <% end %>
  <% end %>
</section>