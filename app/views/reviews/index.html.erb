<h2>
  Reviews of <%= link_to @movie.title, movie_path(@movie) %>
</h2>
<div class="col col-12">

  <table class="table table-striped">
    <% @reviews.each do |review| %>
      <tr>
        <th>Reviewer:</th>
        <td><%= review.name %></td>
      </tr>
      <tr>
        <th>Rating:</th>
        <td><%= "✭" * review.stars %></td>
      </tr>
      <tr>
        <th>Comment:</th>
        <td><%= review.comment %></td>
      </tr>
      <tr>
        <th>Reviewed on:</th>
        <td><%= review.created_at.strftime("%B %d, %Y") %></td>
      </tr>
      <tr>
        <td colspan="2">
        </td>
      </tr>
    <% end %>
  </table>
</div>
