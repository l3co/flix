<h2>
  Reviews of <%= link_to @movie.title, movie_path(@movie) %>
</h2>
<div class="col col-12">
  <% @reviews.each do |review| %>
    <div class="card col-3">
      <div class="card-title">
        <h3 class="title p-2"><%= review.name %></h3>
      </div>
      <div class="card-body">
        <p>
          <%= review.comment %>
        </p>
        <p>
          <strong>Rating:</strong> <%= "✭" * review.stars %>
        </p>
      </div>
      <div class="card-footer">
        <small>Reviewed on <%= review.created_at.strftime("%B %d, %Y") %></small>
      </div>
    </div>
  <% end %>
</div>
