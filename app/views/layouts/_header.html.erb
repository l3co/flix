<header>
  <nav>
    <h1>
      <%= link_to image_tag("logo.png"), root_path %>
    </h1>
    <ul class="left">
      <li>
        <%= link_to "Movies", movies_path %>
      </li>
    </ul>
    <ul class="right">
      <% if current_user %>
        <li><%= link_to current_user.name, user_path(current_user), class: "button" %></li>
        <li><%= link_to "Sign Out", signout_path, data: { turbo_method: :delete }, class: "button" %></li>
      <% else %>
        <li><%= link_to "Sign In", signin_path, class: "button" %></li>
        <li><%= link_to "Sign Up", signup_path, class: "button" %></li>
      <% end %>
    </ul>
  </nav>
</header>